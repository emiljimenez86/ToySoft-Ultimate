rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function userAfter() {
      return getAfter(userPath()).data;
    }

    function cuentaActiva() {
      return hasUserDoc() && (!('activo' in userData()) || userData().activo != false);
    }

    function isAdmin() {
      return cuentaActiva() && userData().rol == 'admin';
    }

    function sameNegocio(negocioId) {
      return cuentaActiva() && userData().negocioId == negocioId;
    }

    function sameNegocioAdmin(negocioId) {
      return sameNegocio(negocioId) && userData().rol == 'admin';
    }

    function sameNegocioStaff(negocioId) {
      return sameNegocio(negocioId) && userData().rol in ['admin', 'mesero'];
    }

    match /codigosEquipo/{codigo} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.negocioId == userData().negocioId;
      allow delete: if isAdmin()
        && resource.data.negocioId == userData().negocioId;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (isAdmin() && resource.data.negocioId == userData().negocioId)
      );
      allow create: if signedIn() && request.resource.data.negocioId is string && (
        (
          request.auth.uid == uid
          && request.resource.data.rol in ['admin', 'mesero']
          && (
            request.resource.data.rol == 'admin' ||
            (
              request.resource.data.rol == 'mesero'
              && request.resource.data.codigoUsado is string
              && exists(/databases/$(database)/documents/codigosEquipo/$(request.resource.data.codigoUsado))
              && get(/databases/$(database)/documents/codigosEquipo/$(request.resource.data.codigoUsado)).data.negocioId
                == request.resource.data.negocioId
            )
          )
        ) || (
          isAdmin()
          && request.resource.data.rol == 'mesero'
          && request.resource.data.negocioId == userData().negocioId
        )
      );
      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.rol == resource.data.rol
        ) || (
          isAdmin()
          && resource.data.negocioId == userData().negocioId
          && resource.data.rol == 'mesero'
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.rol == 'mesero'
        )
      );
      allow delete: if isAdmin()
        && resource.data.negocioId == userData().negocioId
        && resource.data.rol == 'mesero';
    }

    match /negocios/{negocioId} {
      allow read: if sameNegocioStaff(negocioId);
      allow create: if signedIn()
        && existsAfter(userPath())
        && userAfter().rol == 'admin'
        && userAfter().negocioId == negocioId;
      allow update: if sameNegocioAdmin(negocioId);
      allow delete: if false;

      match /catalogo/{docId} {
        allow read: if sameNegocioStaff(negocioId);
        allow write: if sameNegocioAdmin(negocioId);
      }
      match /operacion/{docId} {
        allow read, write: if sameNegocioStaff(negocioId);
      }
      match /ventas/{docId} {
        allow read, write: if sameNegocioAdmin(negocioId);
      }
      match /gastos/{docId} {
        allow read, write: if sameNegocioAdmin(negocioId);
      }
      match /cierres/{docId} {
        allow read, write: if sameNegocioAdmin(negocioId);
      }
      match /cierresOperativos/{docId} {
        allow read, write: if sameNegocioAdmin(negocioId);
      }
      match /inventario/{docId} {
        allow read, write: if sameNegocioAdmin(negocioId);
      }
      match /datos/{docId} {
        allow read: if sameNegocioStaff(negocioId);
        allow create: if sameNegocioAdmin(negocioId) || (
          sameNegocioStaff(negocioId)
          && request.resource.data.keys().hasOnly(['clientes', 'actualizadoEn'])
          && request.resource.data.clientes is list
        );
        allow update: if sameNegocioAdmin(negocioId) || (
          sameNegocioStaff(negocioId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clientes', 'actualizadoEn'])
          && request.resource.data.clientes is list
          && (
            !('clientes' in resource.data)
            || request.resource.data.clientes.size() >= resource.data.clientes.size()
          )
        );
        allow delete: if sameNegocioAdmin(negocioId);
      }
      match /config/{docId} {
        allow read, write: if sameNegocioAdmin(negocioId);
      }
      match /{subcol}/{docId} {
        allow read, write: if sameNegocioAdmin(negocioId);
      }
    }
  }
}
