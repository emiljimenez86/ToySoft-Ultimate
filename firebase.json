{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/mesero", "destination": "/mesero/", "type": 301 },
      { "source": "/pos", "destination": "/pos/", "type": 301 },
      { "source": "/propietario", "destination": "/propietario/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/mesero/", "destination": "/mesero.html" },
      { "source": "/pos/", "destination": "/POS.html" },
      { "source": "/propietario/", "destination": "/propietario.html" }
    ]
  }
}
